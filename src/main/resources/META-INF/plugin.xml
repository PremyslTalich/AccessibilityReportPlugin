<!-- Plugin Configuration File. See https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>cz.talich.arp</id>
    <name>ARP - Accessibility Report</name>
    <vendor>Přemysl Talich</vendor>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Accessibility Report"
                    secondary="true"
                    anchor="right"
                    factoryClass="cz.talich.arp.ArpToolWindowFactory"
                    icon="/icons/toolWindow.svg"/>
    </extensions>
</idea-plugin>
